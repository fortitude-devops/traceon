# Скопируйте в .env:  cp .env.example .env
# Нужен только при запуске БЕЗ Docker (скрипты ml/ и uvicorn на Mac).
# В Docker настройки берутся из docker-compose.yml.

# База из docker compose (порт 5433 на Mac):
DATABASE_URL=postgresql+psycopg://traceon:traceon@localhost:5433/traceon
# Или PostgreSQL из Homebrew (замените ВАШ_ЛОГИН на результат команды whoami):
# DATABASE_URL=postgresql+psycopg://ВАШ_ЛОГИН@localhost:5432/traceon

# Необязательно: заключение через LLM (ключ с build.nvidia.com). Без ключа — шаблон.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
